    <title>Sliding_window.java</title></head><body><div class='breadcrumb'><a href='index.html'>🏠 Home</a> / Sliding_window.java</div><h2>Sliding_window.java</h2><pre><code>package dsa;

public class Sliding_window {
	public static void main(String args[]) {
		int[] arr = {100,200,300,400};
		int k = 2;
		int maxsum = 0;
		int winsum = 0;
		for(int i =0;i&lt;k;i++) {
			winsum+=arr[i];
		}
		maxsum = winsum;
		for(int i = k;i&lt;arr.length;i++) {
			// arr[i-k] -&gt; previous which is start element of window - 1
			// arr[i] -&gt; current window end element
			winsum = winsum - arr[i-k] + arr[i];
			if(winsum&gt;maxsum)
				maxsum = winsum;
		}
		System.out.println(maxsum);
	}
}
