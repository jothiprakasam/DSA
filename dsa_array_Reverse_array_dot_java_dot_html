    <title>Reverse_array.java</title></head><body><div class='breadcrumb'><a href='index.html'>🏠 Home</a> / Reverse_array.java</div><h2>Reverse_array.java</h2><pre><code>package dsa.array;

public class Reverse_array {

	public static void main(String[] args) {
		int[] arr = {0};
		int l = 0;
		int h = arr.length-1;
		while(l&lt;h) {
		int temp = arr[l];
		arr[l] = arr[h];
		arr[h] = temp;
		l++;
		h--;
		}
		for(int a: arr)
			System.out.println(a);
	}

}
