    <title>Second_largest_2.java</title></head><body><div class='breadcrumb'><a href='index.html'>🏠 Home</a> / Second_largest_2.java</div><h2>Second_largest_2.java</h2><pre><code>package dsa.array;

public class Second_largest_2 {

	public static void main(String[] args) {
		int[] arr = {3,2,2,3,1,4};
		int largest = Integer.MIN_VALUE;
		// first loop - O(N)
		for(int i =0;i&lt;arr.length;i++) {
			if(arr[i] &gt; largest) {
				largest = arr[i];
			}
		}
		
		// second loop - O(N)
		int second_largest = Integer.MIN_VALUE;
		for(int i =0;i&lt;arr.length;i++) {
			if(arr[i] &lt; largest &amp;&amp; arr[i] &gt; second_largest) {
				second_largest = arr[i];
			}
		}
		System.out.println(second_largest);
	}

}
