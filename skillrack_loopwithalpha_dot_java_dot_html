  public static void main(String args[]) {
	  int n=25;
	  for(int i=0;i&lt;n;i++) { 
		  for(int j=0;j&lt;n;j++) {
			  char c = &#x27;a&#x27;;
			  for(int k=0;k&lt;i+j+1;k++) {
				  if(c&gt;&#x27;z&#x27;) {
				  c=&#x27;a&#x27;;
				  }
				  System.out.print(c);
				  ++c;
			  }
			  System.out.print(&quot; &quot;);
		} 
		  System.out.println();
	}
  }
}
