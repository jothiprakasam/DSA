import java.util.*;
import java.lang.*;
import java.io.*;
public class twin {
	public static void main (String[] args) {
	    Scanner sc = new Scanner(System.in);
	    int N = sc.nextInt();
	    int Q= sc.nextInt();
	    int arr[] = new int[N];
	    for(int i=0;i&lt;N;i++) {
	    	arr[i] = sc.nextInt();
	    }
	    for(int i=0;i&lt;Q;i++) {
			/*
			 * long query = sc.nextInt(); long flag_a = -1; long flag_b = -1;
			 */
			/*
			 * for(int j=0;j&lt;N;j++) { if(arr[j]==query &amp;&amp; (flag_a==-1)) { flag_a=j+1;
