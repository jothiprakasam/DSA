	    	long flag_a = -1; long flag_b = -1;
	    	int low=0;
	    	int mid;
	    	int high=arr.length-1;
	    	
	    	while(low&lt;=high) {
	    		mid=low+(high-low)/2;
	    		if(arr[mid]&gt;=query) {
	    			if(arr[mid]==query)
	    				flag_a=mid;
	    			low=mid+1;
	    		}else
	    			high=mid-1;
	    	}
	    	int low2=0;
	    	int mid2;
	    	int high2=arr.length-1;
	    	while(low2&lt;=high2) {
	    		mid2=low2+(high2-low2)/2;
	    		if(arr[mid2]&lt;=query) {
	    			if(arr[mid2]==query)
	    				flag_b=mid2;
	    			low2=mid2+1;
	    		}else
	    			high2=mid2-1;
	    	}
	    	System.out.println(flag_a+&quot; &quot;+flag_b);
	    }
	    
	}
}
